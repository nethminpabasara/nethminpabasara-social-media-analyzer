{
  "manifest_version": 3,
  "name": "Social Analyzer Scraper",
  "version": "1.0",
  "description": "Scrapes public profile data for AI analysis",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://*.tiktok.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}